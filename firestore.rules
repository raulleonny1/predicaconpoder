rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mensajes de predicación por usuario (solo el dueño de la cuenta)
    match /users/{userId}/sermons/{sermonId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sesión en vivo (mensaje + consola + pizarra entre dispositivos)
    match /users/{userId}/live/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Contador de lecturas del blog (solo escritura desde servidor Admin)
    match /blogReads/{slug} {
      allow read: if true;
      allow write: if false;
    }
  }
}
